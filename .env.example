# Personal API Token ClickUp (formato pk_xxx).
# Genera: app.clickup.com -> Settings -> Apps -> "Generate" (API Token section).
# Copia il valore qui sotto, rinomina questo file in .env.
CLICKUP_API_TOKEN=pk_your_token_here

# Facoltativo: workspace di default per export_tasks (l'ID nell'URL app.clickup.com/<ID>/...).
# CLICKUP_TEAM_ID=
